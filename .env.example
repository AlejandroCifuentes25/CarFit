# Copia este archivo como .env y ajusta los valores.
# Las Factories de marketplace/infra/factories.py leen estas variables
# para decidir qué implementación inyectar, sin tocar el código.

# Validación documental del vehículo (SOAT / tecnomecánica)
#   MOCK -> aprueba siempre, no consulta servicios externos (desarrollo)
#   REAL -> verifica vigencia real de los documentos (producción)
VALIDADOR_DOCUMENTAL=MOCK

# Notificación al vendedor cuando su artículo queda publicado
#   MOCK -> imprime en consola (desarrollo)
#   REAL -> envía correo con el backend de Django (producción)
NOTIFICADOR=MOCK

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DEFAULT_FROM_EMAIL=no-responder@carfit.co
